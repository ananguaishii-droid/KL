local function makeButton(parent, text, xAnchor, offset)
    return create("TextButton", {
        Size = UDim2.fromOffset(26, 22),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, offset, 0.5, 0),
        BackgroundColor3 = THEME.Off,
        Text = text,
        TextColor3 = THEME.Text,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = true,
        Parent = parent,
    }, { create("UICorner", { CornerRadius = UDim.new(0, 6) }) })
end

local minimizeBtn = makeButton(titleBar, "-", 1, -38)
local closeBtn    = makeButton(titleBar, "X", 1, -8)

local layoutOrder = 0
local function nextOrder()
    layoutOrder += 1
    return layoutOrder
end

local function addToggle(label, initial, callback)
    local state = initial
    local row = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = THEME.Panel,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = nextOrder(),
        Parent = body,
    }, { create("UICorner", { CornerRadius = UDim.new(0, 8) }) })

    create("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = THEME.Text,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local pill = create("Frame", {
        Size = UDim2.fromOffset(38, 18),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        BackgroundColor3 = state and THEME.Accent or THEME.Off,
        Parent = row,
    }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Parent = pill,
    }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

    row.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(pill, TweenInfo.new(0.15), {
            BackgroundColor3 = state and THEME.Accent or THEME.Off,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        }):Play()
        safe(callback, state)
    end)
end

addToggle("Auto Farm", false, function(v)
    State.AutoFarm = v
    if v then
        Mover.Hold()
    else
        Mover.CancelTween()
        if not State.AutoFruit then Mover.Release() end
        State.Status = "Idle"
    end
end)

addToggle("Collect Fruits", false, function(v)
    State.AutoFruit = v
    if not v and not State.AutoFarm then
        Mover.CancelTween()
        Mover.Release()
    end
end)

addToggle("Safety Retreat", true, function(v)
    State.Safety = v
    if not v then State.Retreating = false end
end)

addToggle("Low-Lag Mode", false, function(v)
    State.LowLag = v
    if v then LowLag.Enable() else LowLag.Disable() end
end)

-- Weapon cycle button
local weaponBtn = create("TextButton", {
    Size = UDim2.new(1, 0, 0, 34),
    BackgroundColor3 = THEME.Panel,
    Text = "Weapon: " .. CONFIG.WeaponTypes[CONFIG.WeaponIndex],
    TextColor3 = THEME.Text,
    TextSize = 13,
    Font = Enum.Font.Gotham,
    LayoutOrder = nextOrder(),
    Parent = body,
}, { create("UICorner", { CornerRadius = UDim.new(0, 8) }) })

weaponBtn.MouseButton1Click:Connect(function()
    CONFIG.WeaponIndex = (CONFIG.WeaponIndex % #CONFIG.WeaponTypes) + 1
    weaponBtn.Text = "Weapon: " .. CONFIG.WeaponTypes[CONFIG.WeaponIndex]
end)

-- Stats panel
local statsLabel = create("TextLabel", {
    Size = UDim2.new(1, 0, 0, 96),
    BackgroundColor3 = THEME.Panel,
    TextColor3 = THEME.SubText,
    TextSize = 12,
    Font = Enum.Font.Code,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top,
    Text = "",
    LayoutOrder = nextOrder(),
    Parent = body,
}, {
    create("UICorner", { CornerRadius = UDim.new(0, 8) }),
    create("UIPadding", {
        PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
    }),
})

task.spawn(function()
    while alive do
        local targetName = (State.Target and State.Target.Parent) and State.Target.Name or "none"
        statsLabel.Text = table.concat({
            "Status : " .. State.Status,
            "Target : " .. targetName,
            "Kills  : " .. State.Kills,
            "Fruits : " .. State.FruitsGot,
            "HP     : " .. string.format("%d%%", healthFraction() * 100),
            "Uptime : " .. formatTime(os.clock() - State.Started),
        }, "\n")
        task.wait(0.5)
    end
end)

-- Dragging (mouse + touch)
do
    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    maid:Give(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end))
end

-- Minimize
do
    local minimized = false
    minimizeBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        body.Visible = not minimized
        main.Size = minimized and UDim2.fromOffset(250, 34) or UDim2.fromOffset(250, 340)
        minimizeBtn.Text = minimized and "+" or "-"
    end)
end

---------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------
local function destroy()
    alive = false
    State.AutoFarm, State.AutoFruit = false, false
    State.LowLag = false
    LowLag.Disable()
    Mover.CancelTween()
    Mover.Release()
    maid:Clean()
    env.AxiomBF = nil
end

closeBtn.MouseButton1Click:Connect(destroy)

env.AxiomBF = {
    Destroy = destroy,
    State   = State,
    Config  = CONFIG,
}

task.spawn(farmLoop)
task.spawn(fruitLoop)

print(("[Axiom] Blox Fruits suite v%s loaded."):format(CONFIG.Version))
