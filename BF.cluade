    Bg       = Color3.fromRGB(18, 18, 24),
    Panel    = Color3.fromRGB(28, 28, 38),
    Accent   = Color3.fromRGB(94, 129, 255),
    Off      = Color3.fromRGB(60, 60, 76),
    Text     = Color3.fromRGB(235, 235, 245),
    SubText  = Color3.fromRGB(150, 150, 170),
}

