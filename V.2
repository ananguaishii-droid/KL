local function addToggle(page, label, initial, callback)
    local state = initial
    local row = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = THEME.Panel,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = nextOrder(),
