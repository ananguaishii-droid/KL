        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 52,
        Parent = card,
    })
    local info = TweenInfo.new(0.2)
    TweenService:Create(card, info, { BackgroundTransparency = 0.05 }):Play()
    TweenService:Create(bar, info, { BackgroundTransparency = 0 }):Play()
    TweenService:Create(lbl, info, { TextTransparency = 0 }):Play()
    task.delay(duration, function()
        if not card.Parent then return end
        TweenService:Create(card, info, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(bar, info, { BackgroundTransparency = 1 }):Play()
        local t = TweenService:Create(lbl, info, { TextTransparency = 1 })
        t:Play()
        t.Completed:Wait()
        if card.Parent then card:Destroy() end
    end)
end

---------------------------------------------------------------------
-- Mover
---------------------------------------------------------------------
local Mover = {}
local activeTween

function Mover.Hold()
    local root = getRoot()
    if not root then return end
    local bv = root:FindFirstChild("PROCYSIS_Hold")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "PROCYSIS_Hold"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.zero
        bv.Parent = root
    end
end

function Mover.Release()
    local root = getRoot()
    if root then
        local bv = root:FindFirstChild("PROCYSIS_Hold")
        if bv then bv:Destroy() end
    end
end

function Mover.CancelTween()
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end
end

function Mover.GoTo(goal)
    local root = getRoot()
    if not root then return end
    local dist = (root.Position - goal.Position).Magnitude
    if dist <= CONFIG.CloseRange then
        Mover.CancelTween()
        root.CFrame = goal
        return
    end
    if activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing then
        return
    end
    activeTween = TweenService:Create(
        root,
        TweenInfo.new(dist / CONFIG.TweenSpeed, Enum.EasingStyle.Linear),
        { CFrame = goal }
    )
    activeTween:Play()
end

