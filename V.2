    create("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = THEME.Text,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local pill = create("Frame", {
        Size = UDim2.fromOffset(38, 18),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        BackgroundColor3 = state and THEME.AccentA or THEME.Off,
        Parent = row,
    }, { corner(9) })

    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Parent = pill,
    }, { corner(7) })

    row.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(pill, TweenInfo.new(0.15), {
            BackgroundColor3 = state and THEME.AccentA or THEME.Off,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        }):Play()
        safe(callback, state)
    end)
end

local function addButton(page, label, callback)
    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = THEME.Panel2,
        Text = label,
        TextColor3 = THEME.Text,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        LayoutOrder = nextOrder(),
        Parent = page,
    }, { corner(8) })
    btn.MouseButton1Click:Connect(function()
        safe(callback, btn)
    end)
    return btn
end

local function addCycle(page, prefix, options, getIndex, setIndex)
    local btn
    btn = addButton(page, prefix .. options[getIndex()], function()
        local i = (getIndex() % #options) + 1
        setIndex(i)
        btn.Text = prefix .. options[i]
    end)
    return btn
end

local function addSlider(page, label, min, max, default, step, callback)
    local value = default
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = THEME.Panel,
        LayoutOrder = nextOrder(),
        Parent = page,
    }, { corner(8) })

    local title = create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.fromOffset(10, 4),
        BackgroundTransparency = 1,
        Text = label .. ": " .. tostring(value),
        TextColor3 = THEME.Text,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local hit = create("TextButton", {
        Size = UDim2.new(1, -20, 0, 22),
        Position = UDim2.fromOffset(10, 24),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Parent = row,
    })

    local bar = create("Frame", {
        Size = UDim2.new(1, 0, 0, 6),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        BackgroundColor3 = THEME.Off,
        BorderSizePixel = 0,
        Parent = hit,
    }, { corner(3) })

    local fill = create("Frame", {
        Size = UDim2.fromScale((value - min) / (max - min), 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = bar,
    }, { corner(3), gradient(0) })

    local dragging = false
    local function setFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        local raw = min + (max - min) * rel
        value = math.clamp(math.floor(raw / step + 0.5) * step, min, max)
        fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
        title.Text = label .. ": " .. tostring(value)
        safe(callback, value)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    maid:Give(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end))
end

local function addTextBox(page, label, placeholder, callback)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = THEME.Panel,
        LayoutOrder = nextOrder(),
        Parent = page,
    }, { corner(8) })

    create("TextLabel", {
